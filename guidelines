# Initialize components
from src.orchestration.deterministic_flow import DeterministicAnalysisFlow
from src.storage.storage_manager import StorageManager
from src.core.llm_manager import LocalLLMManager

flow = DeterministicAnalysisFlow(
    storage_manager=StorageManager(),
    llm_manager=LocalLLMManager(),
    calculator=FinancialCalculator()
)

@app.post("/api/v2/analyze")
async def start_analysis(
    file: UploadFile,
    company_name: str,
    background_tasks: BackgroundTasks
):
    """
    Start company analysis
    """
    
    # Validate PDF
    if not file.filename.endswith('.pdf'):
        raise HTTPException(400, "Only PDF files accepted")
    
    # Save uploaded file
    analysis_id = str(uuid.uuid4())
    file_path = f"/tmp/{analysis_id}.pdf"
    
    with open(file_path, "wb") as f:
        content = await file.read()
        f.write(content)
    
    # Start analysis in background
    background_tasks.add_task(
        flow.analyze_company,
        pdf_path=file_path,
        company_name=company_name
    )
    
    return {
        "analysis_id": analysis_id,
        "status": "processing",
        "message": "Analysis started",
        "check_status_url": f"/api/v2/status/{analysis_id}"
    }

