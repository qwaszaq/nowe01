import pdfplumber
from typing import List, Dict, Any
import hashlib

class PDFProcessor:
    """Deterministic PDF extraction"""
    
    def extract_all(self, pdf_path: str) -> Dict[str, Any]:
        """Extract everything from PDF"""
        
        with pdfplumber.open(pdf_path) as pdf:
            extracted = {
                'metadata': self._extract_metadata(pdf),
                'pages': [],
                'tables': [],
                'text_chunks': []
            }
            
            for page_num, page in enumerate(pdf.pages, 1):
                # Extract text
                text = page.extract_text()
                if text:
                    extracted['pages'].append({
                        'page_num': page_num,
                        'text': text,
                        'char_count': len(text)
                    })
                
                # Extract tables
                tables = page.extract_tables()
                for table_idx, table in enumerate(tables):
                    extracted['tables'].append({
                        'page_num': page_num,
                        'table_id': f"p{page_num}_t{table_idx}",
                        'data': table,
                        'rows': len(table),
                        'cols': len(table[0]) if table else 0
                    })
            
            # Create chunks for text (750 chars, 120 overlap)
            extracted['text_chunks'] = self._create_chunks(extracted['pages'])
            
            return extracted
    
    def _create_chunks(self, pages: List[Dict], chunk_size: int = 750, overlap: int = 120) -> List[Dict]:
        """Smart chunking preserving page numbers"""
        chunks = []
        
        for page in pages:
            text = page['text']
            page_num = page['page_num']
            
            # Don't chunk if text is small
            if len(text) <= chunk_size:
                chunks.append({
                    'chunk_id': hashlib.md5(text.encode()).hexdigest()[:8],
                    'text': text,
                    'page_num': page_num,
                    'char_count': len(text)
                })
                continue
            
            # Chunk with overlap
            start = 0
            chunk_idx = 0
            
            while start < len(text):
                end = min(start + chunk_size, len(text))
                chunk_text = text[start:end]
                
                chunks.append({
                    'chunk_id': hashlib.md5(chunk_text.encode()).hexdigest()[:8],
                    'text': chunk_text,
                    'page_num': page_num,
                    'chunk_idx': chunk_idx,
                    'char_count': len(chunk_text)
                })
                
                start += chunk_size - overlap
                chunk_idx += 1
        
        return chunks
    
    def _extract_metadata(self, pdf) -> Dict:
        """Extract PDF metadata"""
        return {
            'pages_count': len(pdf.pages),
            'metadata': pdf.metadata if hasattr(pdf, 'metadata') else {}
        }
