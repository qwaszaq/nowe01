from typing import Dict, Any, List
import asyncio
from concurrent.futures import ThreadPoolExecutor

class DeterministicAnalysisFlow:
    """
    Fixed analysis flow - NO decisions by LLM
    """
    
    def __init__(self, storage_manager, llm_manager, calculator):
        self.storage = storage_manager
        self.llm = llm_manager
        self.calc = calculator
        self.state = {}
        
    async def analyze_company(self, pdf_path: str, company_name: str) -> Dict:
        """
        Main analysis pipeline - fully deterministic
        """
        
        # STEP 1: Extract (0% LLM)
        print(f"[1/6] Extracting data from PDF...")
        extracted_data = await self._extract_phase(pdf_path)
        
        # STEP 2: Store & Index (0% LLM)
        print(f"[2/6] Indexing in databases...")
        await self._storage_phase(extracted_data, company_name)
        
        # STEP 3: Calculate (0% LLM)
        print(f"[3/6] Calculating metrics...")
        metrics = await self._calculation_phase(extracted_data)
        
        # STEP 4: Micro-LLM Interpretation (100% LLM but tiny)
        print(f"[4/6] Running micro-agents...")
        interpretations = await self._micro_llm_phase(metrics)
        
        # STEP 5: Quality Check (0% LLM)
        print(f"[5/6] Validating results...")
        validated = await self._validation_phase(metrics, interpretations)
        
        # STEP 6: Compile Report (0% LLM)
        print(f"[6/6] Generating report...")
        report = await self._compilation_phase(validated)
        
        return report
    
    async def _extract_phase(self, pdf_path: str) -> Dict:
        """Pure extraction - no LLM"""
        from src.core.extractors.pdf_processor import PDFProcessor
        
        processor = PDFProcessor()
        data = processor.extract_all(pdf_path)
        
        # Save state
        self.state['extraction'] = {
            'pages': len(data['pages']),
            'tables': len(data['tables']),
            'chunks': len(data['text_chunks'])
        }
        
        return data
    
    async def _storage_phase(self, data: Dict, company: str) -> None:
        """Store in all databases"""
        
        # 1. Embeddings to Qdrant
        for chunk in data['text_chunks']:
            embedding = await self.storage.create_embedding(chunk['text'])
            await self.storage.store_in_qdrant(
                text=chunk['text'],
                embedding=embedding,
                metadata={
                    'page': chunk['page_num'],
                    'company': company,
                    'chunk_id': chunk['chunk_id']
                }
            )
        
        # 2. Full text to Elasticsearch
        for page in data['pages']:
            await self.storage.store_in_elastic(
                text=page['text'],
                metadata={
                    'page': page['page_num'],
                    'company': company
                }
            )
        
        # 3. Structured data to PostgreSQL
        for table in data['tables']:
            await self.storage.store_in_postgres(
                table_data=table['data'],
                metadata={
                    'table_id': table['table_id'],
                    'page': table['page_num'],
                    'company': company
                }
            )
    
    async def _calculation_phase(self, data: Dict) -> Dict:
        """Pure Python calculations"""
        
        # Extract numbers from tables
        financials = self.calc.extract_financials(data['tables'])
        
        # Calculate all ratios
        metrics = {
            'debt_to_equity': financials.get('debt', 0) / max(financials.get('equity', 1), 1),
            'current_ratio': financials.get('current_assets', 0) / max(financials.get('current_liabilities', 1), 1),
            'ebitda_margin': financials.get('ebitda', 0) / max(financials.get('revenue', 1), 1),
            'revenue_growth': self.calc.calculate_growth(financials.get('revenue_history', [])),
            'roe': financials.get('net_income', 0) / max(financials.get('equity', 1), 1),
            # ... 50+ more metrics
        }
        
        return metrics
    
    async def _micro_llm_phase(self, metrics: Dict) -> Dict:
        """
        Run micro-agents in parallel
        Each makes ONE tiny decision
        """
        interpretations = {}
        
        # Parallel execution
        with ThreadPoolExecutor(max_workers=10) as executor:
            futures = []
            
            # Create micro-tasks
            if 'debt_to_equity' in metrics:
                futures.append(
                    executor.submit(
                        self.llm.call_micro_agent,
                        agent_name='debt_level',
                        value=metrics['debt_to_equity']
                    )
                )
            
            if 'current_ratio' in metrics:
                futures.append(
                    executor.submit(
                        self.llm.call_micro_agent,
                        agent_name='liquidity_risk',
                        value=metrics['current_ratio']
                    )
                )
            
            # Collect results
            for future in futures:
                result = future.result()
                interpretations[result['metric']] = result['interpretation']
        
        return interpretations
    
    async def _validation_phase(self, metrics: Dict, interpretations: Dict) -> Dict:
        """Validate all results"""
        
        validated = {
            'metrics': metrics,
            'interpretations': interpretations,
            'validation': {
                'completeness': len(metrics) / 50,  # Expected 50 metrics
                'consistency': self._check_consistency(metrics),
                'quality_score': self._calculate_quality(metrics, interpretations)
            }
        }
        
        return validated
    
    async def _compilation_phase(self, validated: Dict) -> Dict:
        """Compile final report"""
        
        return {
            'company_analysis': {
                'financial_health_score': self._calculate_health_score(validated),
                'key_metrics': validated['metrics'],
                'interpretations': validated['interpretations'],
                'risks': self._identify_risks(validated),
                'opportunities': self._identify_opportunities(validated)
            },
            'metadata': {
                'analysis_date': datetime.now().isoformat(),
                'quality_score': validated['validation']['quality_score'],
                'completeness': validated['validation']['completeness']
            }
        }
