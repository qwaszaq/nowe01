# Investigation Intelligence Platform - Environment Configuration

# Application
APP_NAME="Investigation Intelligence Platform"
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# LM Studio (Your local LLM server)
LLM_ENDPOINT=http://192.168.200.226:1234/v1
LLM_DEFAULT_MODEL=gemma
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cuda

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Elasticsearch
ELASTIC_HOST=localhost
ELASTIC_PORT=9200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=investigation_db
POSTGRES_USER=investigator
POSTGRES_PASSWORD=secure_pass_123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Processing
MAX_FILE_SIZE=524288000
CHUNK_SIZE=750
CHUNK_OVERLAP=120
